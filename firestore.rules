rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'st.loei2020@gmail.com' ||
         (request.auth.token.email_verified == true && request.auth.token.email == 'st.loei2020@gmail.com'));
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
        (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidPlace(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.category is string && (data.category in ['stay', 'restaurant', 'cafe', 'attraction', 'souvenir']) &&
             data.district is string && data.district.size() > 0 && data.district.size() <= 80 &&
             data.description is string && data.description.size() > 0 && data.description.size() <= 3000 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 500;
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.excerpt is string && data.excerpt.size() > 0 && data.excerpt.size() <= 500 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 10000 &&
             data.author is string && data.author.size() > 0 && data.author.size() <= 100 &&
             data.coverImage is string && data.coverImage.size() > 0 && data.coverImage.size() <= 500;
    }

    // Places collection: Public readable for travelers, managed by admins
    match /places/{placeId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(placeId) && isValidPlace(request.resource.data);
      allow update: if isAdmin() && isValidId(placeId) && isValidPlace(request.resource.data);
      allow delete: if isAdmin() && isValidId(placeId);
    }

    // Articles collection: Public readable for readers, managed by admins
    match /articles/{articleId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(articleId) && isValidArticle(request.resource.data);
      allow update: if isAdmin() && isValidId(articleId) && isValidArticle(request.resource.data);
      allow delete: if isAdmin() && isValidId(articleId);
    }

    // Admins collection: Only accessible by authenticated admins
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isBootstrappedAdmin();
    }
  }
}
