{
  "entities": {
    "Place": {
      "title": "Place",
      "description": "A travel destination, accommodation, cafe, restaurant, or viewpoint in Loei province",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the place"
        },
        "name": {
          "type": "string",
          "description": "Name of the place in Thai",
          "maxLength": 150
        },
        "nameEn": {
          "type": "string",
          "description": "Name of the place in English",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "description": "Category of place",
          "enum": ["stay", "restaurant", "cafe", "attraction", "souvenir"]
        },
        "district": {
          "type": "string",
          "description": "District name in Loei province",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the destination",
          "maxLength": 3000
        },
        "shortDescription": {
          "type": "string",
          "description": "Short excerpt for card displays",
          "maxLength": 400
        },
        "imageUrl": {
          "type": "string",
          "description": "Main cover image URL or local asset path",
          "maxLength": 500
        },
        "gallery": {
          "type": "array",
          "description": "List of gallery image URLs (4-5 images)",
          "items": { "type": "string" }
        },
        "standards": {
          "type": "array",
          "description": "Certifications, standards and awards with logo",
          "items": {
            "type": "object"
          }
        },
        "address": {
          "type": "string",
          "description": "Physical address or landmark description",
          "maxLength": 300
        },
        "phone": {
          "type": "string",
          "description": "Contact telephone number",
          "maxLength": 50
        },
        "priceRange": {
          "type": "string",
          "description": "Price level or admission fee",
          "maxLength": 80
        },
        "openingHours": {
          "type": "string",
          "description": "Business or visiting hours",
          "maxLength": 100
        },
        "googleMapsUrl": {
          "type": "string",
          "description": "Google Maps link or search query",
          "maxLength": 500
        },
        "facebookUrl": {
          "type": "string",
          "description": "Facebook Page link",
          "maxLength": 500
        },
        "lineUrl": {
          "type": "string",
          "description": "LINE Official or Contact link",
          "maxLength": 500
        },
        "websiteUrl": {
          "type": "string",
          "description": "Official Website link",
          "maxLength": 500
        },
        "rating": {
          "type": "number",
          "description": "Editorial or visitor rating from 1 to 5"
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Whether to highlight on homepage"
        },
        "tags": {
          "type": "array",
          "description": "Highlight tags",
          "items": { "type": "string" }
        },
        "viewsCount": {
          "type": "number",
          "description": "Number of times viewed"
        },
        "sharesCount": {
          "type": "number",
          "description": "Number of times shared"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["name", "category", "district", "description", "imageUrl"]
    },
    "Article": {
      "title": "Article",
      "description": "Editorial travel article, route guide, or seasonal review",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the article"
        },
        "title": {
          "type": "string",
          "description": "Article headline",
          "maxLength": 200
        },
        "excerpt": {
          "type": "string",
          "description": "Deck or introductory summary",
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "description": "Full narrative article body",
          "maxLength": 10000
        },
        "author": {
          "type": "string",
          "description": "Curator or author byline",
          "maxLength": 100
        },
        "readTime": {
          "type": "string",
          "description": "Estimated reading duration",
          "maxLength": 30
        },
        "category": {
          "type": "string",
          "description": "Article classification",
          "maxLength": 50
        },
        "coverImage": {
          "type": "string",
          "description": "Header image URL",
          "maxLength": 500
        },
        "isFeatured": {
          "type": "boolean",
          "description": "Highlighted on home cover"
        },
        "publishedAt": {
          "type": "string",
          "description": "Publication date"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["title", "excerpt", "content", "author", "coverImage"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Visitor view or share event for dashboard analysis",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": ["pageview", "share", "view_place"]
        },
        "placeId": {
          "type": "string"
        },
        "placeName": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": ["type", "timestamp"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Designated administrator user record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "User permission role",
          "enum": ["admin", "superadmin"]
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/places/{placeId}": {
      "schema": "Place",
      "description": "Travel places, accommodations, cafes, restaurants, and attractions in Loei"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Editorial magazine articles and travel guides"
    },
    "/analytics/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Visitor traffic and social share analytics"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators"
    }
  }
}
