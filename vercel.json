{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "place"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Linespider|line-poker|Line|LINE|Twitterbot|Slackbot|Discordbot|WhatsApp|TelegramBot|LinkedInBot|Pinterest|kakaotalk-scrap|Applebot).*"
        }
      ],
      "destination": "/api/share"
    }
  ]
}
